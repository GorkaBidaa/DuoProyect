  m_Script: {fileID: 11500000, guid: 3652706eb15a44b40b2da38c4c3e434b, type: 3}
  m_Name: Tutorial_01_Welcome
  m_EditorClassIdentifier: Assembly-CSharp::TreeDialogueData
  lines:
  - speaker: Alderworn
    text: "Easy, little traveler. I am Alderworn. You are safe beneath my branches."
  - speaker: Alderworn
    text: "The gate ahead needs a Magic Key. Find both key fragments and gather the materials listed in its recipe."
  - speaker: Alderworn
    text: "Return to the crafting station when you have them. I will help you find your next step."
  - speaker: Alderworn
    text: "Your strength fades in the forest. Return to base to recover, and use Food when you need it."
