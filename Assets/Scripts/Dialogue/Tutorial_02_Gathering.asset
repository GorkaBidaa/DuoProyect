  m_Script: {fileID: 11500000, guid: 3652706eb15a44b40b2da38c4c3e434b, type: 3}
  m_Name: Tutorial_02_Gathering
  m_EditorClassIdentifier: Assembly-CSharp::TreeDialogueData
  lines:
  - speaker: Alderworn
    text: "Follow the paths and look for the two fragments. The recipe also needs Gloom and Whisper."
  - speaker: Alderworn
    text: "You cannot fight those creatures head-on. Bait them into spikes, or use your lure and traps."
  - speaker: Alderworn
    text: "Return here to recover. If you spend materials, check the recipe again before crafting."
